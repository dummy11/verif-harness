{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageMergeManifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "collection_config_digest", "merge_profile_digest", "dut_build_fingerprint_digest", "input_database_digests", "output_database_digest", "adapter", "merge_tool", "tool", "adapter_schema_version", "state", "blockers", "request_sha256", "operation", "tool_identity"],
  "properties": {
    "schema": {"const": "CoverageMergeManifest/1"},
    "collection_config_digest": {"$ref": "#/$defs/digest"},
    "merge_profile_digest": {"$ref": "#/$defs/digest"},
    "dut_build_fingerprint_digest": {"$ref": "#/$defs/digest"},
    "input_database_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "output_database_digest": {"$ref": "#/$defs/digest"},
    "adapter": {"$ref": "#/$defs/namedVersion"},
    "merge_tool": {"$ref": "#/$defs/namedVersion"},
    "tool": {"type": "string", "minLength": 1},
    "adapter_schema_version": {"const": 1},
    "state": {"const": "PASS"},
    "blockers": {"type": "array", "maxItems": 0},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"type": "string", "minLength": 1},
    "tool_identity": {"type": "object", "required": ["state"], "properties": {"state": {"const": "PASS"}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "namedVersion": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}
  }
}
