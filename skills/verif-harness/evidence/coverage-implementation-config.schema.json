{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageImplementationConfig/1",
  "description": "负责人批准的覆盖率插桩、elaboration、采集、导出和分析实现绑定；不复制回归 case、seed 或 repeat。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code_coverage_target", "configuration_refs", "compatible_submit_profile_digests", "toolchain"],
  "properties": {
    "schema": {"const": "CoverageImplementationConfig/1"},
    "code_coverage_target": {"const": "dut"},
    "configuration_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["instrumentation", "elaboration", "collection", "export", "analysis"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "compatible_submit_profile_digests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "toolchain": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "name", "version"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
