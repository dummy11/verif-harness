{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegressionBatchManifest/2",
  "description": "Testbench 导出的批准方案和执行轮次清单。只记录实际分配的 seed；控制面不生成 seed 或提交命令。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "batch_id", "regression_group", "submit_profile",
    "caselist", "seed_mode", "repeat", "timeout_seconds", "cases", "runs", "execution_binding"
  ],
  "properties": {
    "schema": {"const": "RegressionBatchManifest/2"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "regression_group": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "submit_profile": {"$ref": "submit-profile-ref.schema.json"},
    "caselist": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "seed_mode": {"enum": ["random", "fixed"]},
    "seed": {"$ref": "#/$defs/seed"},
    "repeat": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "case_digest"],
        "properties": {
          "case_id": {"$ref": "#/$defs/caseId"},
          "case_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "runs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "seed", "iteration"],
        "properties": {
          "case_id": {"$ref": "#/$defs/caseId"},
          "seed": {"$ref": "#/$defs/seed"},
          "iteration": {"type": "integer", "minimum": 0}
        }
      }
    },
    "execution_binding": {"$ref": "#/$defs/executionBinding"},
    "example_only": {"const": true},
    "example_notice": {"type": "string", "minLength": 1}
  },
  "allOf": [{
    "if": {"properties": {"seed_mode": {"const": "fixed"}}},
    "then": {"required": ["seed"]},
    "else": {"not": {"required": ["seed"]}}
  }],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caseId": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "seed": {"oneOf": [
      {"type": "integer", "minimum": 1},
      {"type": "string", "pattern": "^[0-9]*[1-9][0-9]*$"}
    ]},
    "executionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["round_id", "plan_node_id", "plan_revision", "plan_digest"],
      "properties": {
        "round_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "plan_node_id": {"type": "string", "pattern": "^workstream:VREG:[A-Za-z0-9_.:-]+$"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
