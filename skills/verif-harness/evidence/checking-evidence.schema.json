{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckingEvidence/1",
  "type": "object",
  "required": ["schema", "claim", "revision", "tool", "artifacts", "result"],
  "properties": {
    "schema": {"const": "CheckingEvidence/1"},
    "claim": {"enum": ["compare-policy", "reference-model", "scoreboard", "assertions", "reference-model-evidence", "scoreboard-evidence", "assertion-evidence"]},
    "revision": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "kind", "analyzed_by"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "kind": {"type": "string"}, "analyzed_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "result": {"type": "object"}
  }
}
