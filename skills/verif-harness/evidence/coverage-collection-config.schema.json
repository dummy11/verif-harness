{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageCollectionConfig/1",
  "description": "一个 DUT 构建指纹分区的覆盖率收敛配置：只读引用 VREG regression_config 并固定 merge profile；case、submit profile、seed、repeat 仍由 VREG 单一维护。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "regression_sources", "dut_build_fingerprint", "merge_profile"],
  "properties": {
    "schema": {"const": "CoverageCollectionConfig/1"},
    "regression_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["plan_node_id", "plan_revision", "regression_config_digest"],
        "properties": {
          "plan_node_id": {"type": "string", "pattern": "^workstream:VREG:"},
          "plan_revision": {"type": "integer", "minimum": 1},
          "regression_config_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "dut_build_fingerprint": {"$ref": "#/$defs/dutBuildFingerprint"},
    "merge_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "adapter", "tool"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "adapter": {"$ref": "#/$defs/namedVersion"},
        "tool": {"$ref": "#/$defs/namedVersion"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "namedVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "dutBuildFingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "coverage_target", "dut_design_id", "rtl_digest", "parameter_digest", "macro_digest", "dut_elaboration_digest"],
      "properties": {
        "schema": {"const": "DutBuildFingerprint/1"},
        "coverage_target": {"const": "dut"},
        "dut_design_id": {"type": "string", "minLength": 1},
        "rtl_digest": {"$ref": "#/$defs/digest"},
        "parameter_digest": {"$ref": "#/$defs/digest"},
        "macro_digest": {"$ref": "#/$defs/digest"},
        "dut_elaboration_digest": {"$ref": "#/$defs/digest", "description": "DUT-only elaborated design digest normalized independently of testbench hierarchy, wrappers, and absolute instance paths."}
      }
    }
  }
}
