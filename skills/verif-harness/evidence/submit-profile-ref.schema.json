{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmitProfileRef/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_id", "submit_file", "submit_file_digest",
    "profile_digest", "adapter"
  ],
  "properties": {
    "schema": {"const": "SubmitProfileRef/1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "submit_file": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
    "submit_file_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
