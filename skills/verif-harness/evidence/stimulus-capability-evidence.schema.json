{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StimulusCapabilityEvidence/1",
  "type": "object",
  "required": ["schema", "claim", "revision", "tool", "artifacts", "result"],
  "properties": {
    "schema": {"const": "StimulusCapabilityEvidence/1"},
    "claim": {"enum": ["transaction-contract", "stimulus-implementation", "corner-scenarios"]},
    "revision": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "result": {"type": "object"}
  }
}
