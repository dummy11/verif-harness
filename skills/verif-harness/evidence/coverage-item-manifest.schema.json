{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageItemManifest/1",
  "description": "历史 CoverageEvidence/1 使用的覆盖项清单，仅供审计；当前交付使用 CoverageScope/1、CoverageImplementationConfig/1 和 CoverageObjectInventory/2。",
  "type": "object",
  "required": ["schema", "plan_digest", "model_digest", "planned_item_ids", "mapped_item_ids", "adapter_schema_version", "state", "blockers", "request_sha256", "operation", "tool_identity", "tool"],
  "properties": {
    "schema": {"const": "CoverageItemManifest/1"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "planned_item_ids": {"$ref": "#/$defs/itemIds"},
    "mapped_item_ids": {"$ref": "#/$defs/itemIds"},
    "adapter_schema_version": {"const": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "state": {"const": "PASS"},
    "blockers": {"type": "array", "maxItems": 0},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "tool_identity": {
      "type": "object", "required": ["state"],
      "properties": {"state": {"const": "PASS"}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "itemIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}
    }
  }
}
