{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageDatabaseShardManifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_binding", "regression_config_digest", "batch_manifest_digest", "dut_build_fingerprint", "shards"],
  "properties": {
    "schema": {"const": "CoverageDatabaseShardManifest/1"},
    "execution_binding": {"$ref": "#/$defs/binding"},
    "regression_config_digest": {"$ref": "#/$defs/digest"},
    "batch_manifest_digest": {"$ref": "#/$defs/digest"},
    "dut_build_fingerprint": {"$ref": "#/$defs/dutBuildFingerprint"},
    "shards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "runs"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"},
          "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["round_id", "plan_node_id", "plan_revision", "plan_digest"], "properties": {"round_id": {"type": "string", "minLength": 1}, "plan_node_id": {"type": "string", "minLength": 1}, "plan_revision": {"type": "integer", "minimum": 1}, "plan_digest": {"$ref": "#/$defs/digest"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["case_id", "seed", "iteration"], "properties": {"case_id": {"type": "string", "minLength": 1}, "seed": {"oneOf": [{"type": "integer"}, {"type": "string", "minLength": 1}]}, "iteration": {"type": "integer", "minimum": 0}}},
    "dutBuildFingerprint": {"type": "object", "additionalProperties": false, "required": ["schema", "coverage_target", "dut_design_id", "rtl_digest", "parameter_digest", "macro_digest", "dut_elaboration_digest"], "properties": {"schema": {"const": "DutBuildFingerprint/1"}, "coverage_target": {"const": "dut"}, "dut_design_id": {"type": "string", "minLength": 1}, "rtl_digest": {"$ref": "#/$defs/digest"}, "parameter_digest": {"$ref": "#/$defs/digest"}, "macro_digest": {"$ref": "#/$defs/digest"}, "dut_elaboration_digest": {"$ref": "#/$defs/digest", "description": "DUT-only elaborated design digest normalized independently of testbench hierarchy, wrappers, and absolute instance paths."}}}
  }
}
