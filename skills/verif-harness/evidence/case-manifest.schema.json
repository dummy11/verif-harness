{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseManifest/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "entry",
    "source_files",
    "submit_profile",
    "case_digest",
    "traceability"
  ],
  "properties": {
    "schema": {
      "const": "CaseManifest/2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "testcase"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "launcher_test"
          ],
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "launcher_test": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      ]
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "submit_profile": {
      "$ref": "submit-profile-ref.schema.json"
    },
    "case_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "traceability": {
      "$ref": "#/$defs/traceability"
    }
  },
  "$defs": {
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "verification_points",
        "testcase_list",
        "sources",
        "expected_result"
      ],
      "properties": {
        "schema": {
          "const": "CaseTraceability/1"
        },
        "verification_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testcase_list": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "version",
            "locator"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "path",
              "sha256",
              "version",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "specification",
                  "rtl",
                  "coverage-hole",
                  "defect",
                  "reference-model",
                  "engineering-decision"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expected_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "check_method",
            "basis_source_ids",
            "status"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "check_method": {
              "type": "string",
              "minLength": 1
            },
            "basis_source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "enum": [
                "specified",
                "rtl-derived-unconfirmed",
                "confirmed"
              ]
            },
            "confirmation_question_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "confirmed"
                  }
                }
              },
              "then": {
                "required": [
                  "confirmation_question_id"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "confirmation_question_id"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
