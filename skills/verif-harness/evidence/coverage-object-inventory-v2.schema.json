{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageObjectInventory/2",
  "description": "在 CoverageObjectInventory/1 基础上绑定当前 CoverageImplementationConfig/1。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope_digest", "implementation_config_digest", "plan_digest", "model_digest", "objects", "adapter_schema_version", "state", "blockers", "request_sha256", "operation", "tool_identity", "tool"],
  "properties": {
    "schema": {"const": "CoverageObjectInventory/2"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "implementation_config_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["object_key", "category", "kind", "native_path"],
        "properties": {
          "object_key": {"type": "string", "minLength": 1},
          "category": {"enum": ["code", "functional"]},
          "kind": {"enum": ["line", "condition", "branch", "toggle", "fsm", "coverpoint-bin", "cross-bin"]},
          "native_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "adapter_schema_version": {"const": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "state": {"const": "PASS"},
    "blockers": {"type": "array", "maxItems": 0},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "tool_identity": {"type": "object", "required": ["state"], "properties": {"state": {"const": "PASS"}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
