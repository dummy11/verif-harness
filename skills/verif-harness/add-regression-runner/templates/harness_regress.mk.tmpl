# Generated by verif-harness add-regression-runner.
# Include from the project regression Makefile after defining SIM_CMD.

HARNESS_RESULT_PREFIX ?= {{RESULT_PREFIX}}
HARNESS_CASELIST      ?= {{DEFAULT_CASELIST}}
HARNESS_RUNS_DIR     ?= $(CURDIR)/output/regress
HARNESS_SEED         ?= auto
HARNESS_JOBS         ?= 1
HARNESS_REQUIRE_GOLDEN ?=
HARNESS_RUNNER       := $(CURDIR)/run_regression.py
HARNESS_COLLECTOR    := $(CURDIR)/collect_results.py

.PHONY: harness_regress harness_rerun_failed

harness_regress:
	@test -n "$(strip $(SIM_CMD))" || { echo "ERROR: define SIM_CMD with {test} and {seed}"; exit 1; }
	python3 $(HARNESS_RUNNER) --caselist $(HARNESS_CASELIST) \
	  --runs-dir $(HARNESS_RUNS_DIR) --seed $(HARNESS_SEED) \
	  --jobs $(HARNESS_JOBS) -- $(SIM_CMD)
	python3 $(HARNESS_COLLECTOR) --runs-dir $(HARNESS_RUNS_DIR) \
	  --caselist $(HARNESS_CASELIST) --result-prefix $(HARNESS_RESULT_PREFIX) \
	  $(if $(HARNESS_REQUIRE_GOLDEN),--require-golden,)

harness_rerun_failed:
	@test -s $(HARNESS_RUNS_DIR)/failed.caselist || { echo "No failed tests to rerun"; exit 0; }
	python3 $(HARNESS_RUNNER) --caselist $(HARNESS_RUNS_DIR)/failed.caselist \
	  --runs-dir $(HARNESS_RUNS_DIR)_rerun \
	  --seed-file $(HARNESS_RUNS_DIR)/seed.txt --jobs $(HARNESS_JOBS) -- $(SIM_CMD)
	python3 $(HARNESS_COLLECTOR) --runs-dir $(HARNESS_RUNS_DIR)_rerun \
	  --caselist $(HARNESS_RUNS_DIR)/failed.caselist \
	  --result-prefix $(HARNESS_RESULT_PREFIX) \
	  $(if $(HARNESS_REQUIRE_GOLDEN),--require-golden,)
