{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verif-harness/desired-state-proposal.schema.json",
  "title": "DesiredStateProposal/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workstream", "nodes"],
  "allOf": [
    {
      "if": {"properties": {"workstream": {"const": "VDOC"}}},
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "role": {
                  "enum": ["document-writing-plan", "document-deliverable"]
                },
                "document_key": {
                  "enum": [
                    "verification-workflow", "verification-plan", "feature-matrix",
                    "tb-architecture", "reference-model", "coverage-plan",
                    "assertion-plan", "testcase-list"
                  ]
                }
              },
              "required": ["document_key"]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {"const": "DesiredStateProposal/1"},
    "workstream": {"enum": ["VDOC", "VENV", "VSTIM", "VCHK", "VCOV", "VCASE", "VREG"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {"const": "document-writing-plan"},
                "key": {"pattern": "_authoring$"}
              },
              "required": ["role", "key"]
            },
            "then": {"required": ["authoring_contract"]}
          }
        ],
        "required": [
          "key", "title", "role", "parent_key", "statement", "purpose",
          "scope", "acceptance_criteria", "source_refs", "work_content",
          "implementation_approach", "deliverables", "progress_measures",
          "quality_checks", "suggested_mode", "evidence_claim"
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "title": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "parent_key": {"type": "string", "minLength": 1},
          "document_key": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": true},
          "statement": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "work_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "implementation_approach": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "progress_measures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "unit", "target", "source"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1}
              }
            }
          },
          "quality_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "authoring_contract": {"$ref": "#/$defs/authoringContract"},
          "suggested_mode": {"type": "string", "minLength": 1},
          "evidence_claim": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "authoringContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "profile", "generation", "source_requirements",
        "source_snapshot", "source_gaps", "dut_scope",
        "rtl_spec_analysis_method", "document_dependencies",
        "document_structure", "section_authoring_instructions",
        "required_tables", "domain_rules",
        "cross_document_consistency_rules", "traceability_requirements",
        "review", "freeze", "change_invalidation_rules"
      ],
      "properties": {
        "schema": {"const": "VerificationDocumentAuthoringContract/1"},
        "profile": {"type": "object"},
        "generation": {"type": "object"},
        "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "source_snapshot": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "source_gaps": {"type": "array", "items": {"type": "object"}},
        "dut_scope": {"type": "object"},
        "rtl_spec_analysis_method": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "document_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "document_structure": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "section_authoring_instructions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "required_tables": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "domain_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cross_document_consistency_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "traceability_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review": {"type": "object"},
        "freeze": {"type": "object"},
        "change_invalidation_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
