# <verif_root>/filelist/tb.f
# Testbench compile list.
# Order strict per stage1-patterns.md § 1.3 (interface → shared pkg → api pkg
# → UVC pkgs → env pkg → test pkg → structural modules → SVA → clkrst → tb_top).

# ============================================================================
# +incdir — every directory containing .svh a package will include.
# ============================================================================
# >>> GENERATED_INCDIRS <<<
# One `+incdir+<path>` per UVC dir + `seq/` sub-dir + env + test + pkg +
# tb_harness. Example (acc):
#   +incdir+<verif_root>/testbench/uvc/ctrl_agent
#   +incdir+<verif_root>/testbench/uvc/ctrl_agent/seq
#   +incdir+<verif_root>/testbench/uvc/data_in_agent
#   +incdir+<verif_root>/testbench/uvc/data_in_agent/seq
#   +incdir+<verif_root>/testbench/uvc/data_out_agent
#   +incdir+<verif_root>/testbench/uvc/data_out_agent/seq
#   +incdir+<verif_root>/testbench/uvc/sram_agent
#   +incdir+<verif_root>/testbench/uvc/sram_agent/seq
#   +incdir+<verif_root>/testbench/env
#   +incdir+<verif_root>/testbench/env/vseq
#   +incdir+<verif_root>/testbench/test
#   +incdir+<verif_root>/testbench/pkg
#   +incdir+<verif_root>/testbench/top/harness/tb_harness

