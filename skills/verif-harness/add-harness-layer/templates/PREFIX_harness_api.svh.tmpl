// Aggregate harness API — collects reset / status / strap sub-classes.
// Constructed once by <PREFIX>_tb_top and stored in <PREFIX>_env_cfg.harness_api.

class <PREFIX>_harness_api;
  <PREFIX>_reset_api  reset;
  <PREFIX>_status_api status;
  <PREFIX>_strap_api  strap;
  // <PREFIX>_debug_api debug;  // Stage 2+ reserved

  function new(virtual <PREFIX>_harness_if vif);
    reset  = new(vif);
    status = new(vif);
    strap  = new(vif);
  endfunction
endclass
