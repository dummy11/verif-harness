#!/usr/bin/env bash
set -euo pipefail

skill_script_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
package_root="$(cd "$skill_script_dir/../../.." && pwd)"
managed_python="$package_root/scripts/managed-python"
wrapper="$package_root/scripts/verif_harness.py"

if [[ ! -x "$managed_python" || ! -f "$wrapper" || \
      ! -f "$package_root/verif_harness/__init__.py" || \
      ! -f "$package_root/verif_harness/store.py" ]]; then
  echo "ERROR: runtime Skill link does not resolve to a complete verif-harness checkout: $package_root" >&2
  echo "       Rerun setup from the reviewed verif-harness package checkout; do not clone into the workspace." >&2
  exit 2
fi

export VERIF_HARNESS_AGENT_CLI=1
exec "$managed_python" "$wrapper" "$@"
