{
  "backend": "syscan",
  "guard": "USE_GOLDEN",
  "wrapper_name": "demo_golden_bridge",
  "ports": [
    "input logic clk",
    "input logic rst_n",
    "input logic in_valid",
    "input logic [31:0] in_data",
    "output logic out_valid",
    "output logic [31:0] out_data"
  ],
  "syscan": {
    "golden_module": "demo_systemc_shell",
    "instance": "u_golden",
    "connections": {
      "clk": "clk",
      "rst_n": "rst_n",
      "in_valid": "in_valid",
      "in_data": "in_data",
      "out_valid": "out_valid",
      "out_data": "out_data"
    },
    "disabled_assignments": {
      "out_valid": "1'b0",
      "out_data": "'0"
    }
  }
}
