{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verif-harness/stimulus-reachability.schema.json",
  "title": "StimulusReachabilityEvidence/1",
  "type": "object",
  "required": ["schema", "revision", "artifacts", "producer", "observation", "runs"],
  "properties": {
    "schema": {"const": "StimulusReachabilityEvidence/1"},
    "revision": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"const": "vstim-probe"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "required": ["boundary", "point", "predicate"],
      "properties": {
        "boundary": {"enum": ["dut-input-accepted", "driver-monitor-boundary"]},
        "point": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "test", "seed", "config_digest", "stimulus_digest", "errors", "timeouts", "scenarios"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "test": {"type": "string", "minLength": 1},
          "seed": {"type": ["string", "integer"]},
          "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stimulus_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "errors": {"type": "integer", "minimum": 0},
          "timeouts": {"type": "integer", "minimum": 0},
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "required", "generated", "driven", "accepted", "hits"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "generated": {"type": "integer", "minimum": 0},
                "driven": {"type": "integer", "minimum": 0},
                "accepted": {"type": "integer", "minimum": 0},
                "hits": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
