{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dummy11/verif-harness/schemas/xverif.lock.schema.json",
  "title": "verif-harness managed xverif dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "repository",
    "commit",
    "license",
    "license_file_sha256",
    "tools",
    "mcp"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "name": {"const": "xverif"},
    "repository": {
      "const": "https://github.com/BLANK2077/xverif.git"
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"const": "MIT"},
    "license_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": ["xbit", "xcov", "xdebug", "xentry", "xloc", "xsva", "xwaveform"]
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_root",
        "python_source_root",
        "package",
        "entrypoint",
        "launcher",
        "requires_python",
        "dependency"
      ],
      "properties": {
        "source_root": {"const": "xverif_mcp"},
        "python_source_root": {"const": "xverif_mcp/src"},
        "package": {"const": "xverif_mcp"},
        "entrypoint": {"const": "xverif_mcp.server:main"},
        "launcher": {"const": "tools/xverif-mcp"},
        "requires_python": {"const": ">=3.11"},
        "dependency": {"const": "mcp[cli]"}
      }
    }
  }
}
